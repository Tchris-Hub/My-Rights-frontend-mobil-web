{
  "name": "my-rights-backend",
  "version": "0.1.0",
  "private": true,
  "description": "My Rights backend API — Neon PostgreSQL + Prisma. Replaces the Supabase data layer while preserving its authorization model.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.5",
    "@prisma/client": "^5.22.0",
    "better-auth": "^1.7.5",
    "dotenv": "^18.0.2",
    "express": "^4.19.2",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.24",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
