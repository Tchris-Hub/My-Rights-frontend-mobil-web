# My Rights backend — environment placeholders. Copy to `.env` and fill in.
# Never commit `.env`. Secrets belong only on the server, never in the mobile app.

# --- Database (Neon PostgreSQL) ---
# From the Neon dashboard: Connection Details → "Connection string".
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# --- HTTP / API ---
PORT=8080
# Comma-separated list of allowed browser origins (CORS). Empty = no cross-origin access.
ALLOWED_ORIGINS=

# --- Authentication (Better Auth) ---
# Public base URL of this backend, used to construct OAuth callback URLs.
# Dev: a LAN IP or HTTPS tunnel reachable from the phone (e.g. http://192.168.1.10:8080).
BETTER_AUTH_URL=
# Random 32+ byte secret (generate with: openssl rand -base64 32). SECRET — never commit.
BETTER_AUTH_SECRET=

# --- Google OAuth (optional; leave unset to disable Google sign-in) ---
# From Google Cloud Console → OAuth client (Web application).
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email / SMTP (verification, password reset, email change) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@myrights.ng
EMAIL_FROM=no-reply@myrights.ng
